{
  "name": "codelens",
  "displayName": "CodeLens — Offline Semantic Search",
  "description": "Natural-language and keyword search for your codebase, plus code explanations. 100% offline: SQLite + sqlite-vec + optional Ollama.",
  "version": "0.4.0",
  "publisher": "nikhilmourya",
  "repository": {
    "type": "git",
    "url": "https://github.com/TryingtobeingNikhil/CodeLens.git"
  },
  "engines": {
    "vscode": "^1.86.0"
  },
  "categories": [
    "Other",
    "Programming Languages"
  ],
  "keywords": [
    "semantic search",
    "code search",
    "offline",
    "hybrid search",
    "sqlite-vec",
    "ollama"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension/src/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codelens-sidebar",
          "title": "CodeLens Search",
          "icon": "media/codelens-icon.svg"
        }
      ]
    },
    "views": {
      "codelens-sidebar": [
        {
          "type": "webview",
          "id": "codelens.sidebar",
          "name": "Semantic Search"
        }
      ]
    },
    "commands": [
      {
        "command": "codelens.search",
        "title": "CodeLens: Search",
        "icon": "$(search)"
      },
      {
        "command": "codelens.searchSelection",
        "title": "CodeLens: Find Similar Code"
      },
      {
        "command": "codelens.explainSelection",
        "title": "CodeLens: Explain Selection"
      },
      {
        "command": "codelens.reindex",
        "title": "CodeLens: Re-index Workspace",
        "icon": "$(sync)"
      },
      {
        "command": "codelens.rebuildIndex",
        "title": "CodeLens: Rebuild Index From Scratch"
      },
      {
        "command": "codelens.setupBackend",
        "title": "CodeLens: Set Up Search Engine"
      },
      {
        "command": "codelens.restartBackend",
        "title": "CodeLens: Restart Backend"
      },
      {
        "command": "codelens.showStatus",
        "title": "CodeLens: Show Logs"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codelens.reindex",
          "when": "view == codelens.sidebar",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "codelens.searchSelection",
          "when": "editorHasSelection",
          "group": "navigation@9"
        },
        {
          "command": "codelens.explainSelection",
          "when": "editorHasSelection",
          "group": "navigation@10"
        }
      ]
    },
    "keybindings": [
      {
        "command": "codelens.search",
        "key": "ctrl+alt+k",
        "mac": "cmd+alt+k"
      }
    ],
    "configuration": {
      "title": "CodeLens",
      "properties": {
        "codelens.pythonPath": {
          "type": "string",
          "default": "",
          "description": "Python used to run the backend. Empty: the backend folder's .venv, then python3."
        },
        "codelens.backendPath": {
          "type": "string",
          "default": "",
          "description": "Folder containing backend/main.py. Empty: the copy bundled with the extension."
        },
        "codelens.port": {
          "type": "number",
          "default": 8000,
          "description": "Port of the local backend."
        },
        "codelens.autoStartBackend": {
          "type": "boolean",
          "default": true,
          "description": "Start the backend when VS Code starts, unless one is already running."
        },
        "codelens.ollamaHost": {
          "type": "string",
          "default": "",
          "description": "Ollama address for a backend started by the extension, e.g. http://localhost:11434. Empty: the backend's default (OLLAMA_HOST or http://localhost:11434). Ollama is optional: without it, search matches words only and Explain is off."
        },
        "codelens.explainModel": {
          "type": "string",
          "default": "",
          "description": "Ollama model used by Explain, e.g. mistral, llama3.2, qwen2.5-coder. Empty: the backend's default (EXPLAIN_MODEL or mistral). Pull it first: ollama pull <model>."
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "compile": "tsc -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "18.x",
    "@types/vscode": "^1.86.0",
    "@vscode/vsce": "^3.0.0",
    "playwright-core": "^1.48.2",
    "typescript": "^5.3.3"
  },
  "icon": "media/icon.png",
  "license": "MIT",
  "homepage": "https://github.com/TryingtobeingNikhil/CodeLens#readme",
  "bugs": {
    "url": "https://github.com/TryingtobeingNikhil/CodeLens/issues"
  },
  "galleryBanner": {
    "color": "#1E1B4B",
    "theme": "dark"
  }
}
